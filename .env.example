# Server environment; never prefix secrets with VITE_.
NODE_ENV=production
NEXA_ORIGIN=https://cloud.example.com
HOST=127.0.0.1
PORT=5731
NEXA_DATABASE=/var/lib/nexa/nexa.sqlite
NEXA_ARTIFACTS=/var/lib/nexa/artifacts

# Paddle checkout（构建时注入前端）。VITE_PADDLE_ENV 必须显式设置，禁止默认值。
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxx
# Live migration: use production + a live client-side token (live_).
# Do not publish a live build until sandbox testing and account/domain approval.
# Live checkout remains disabled in Pricing.vue pending the separate go-live step.
# Live catalog only. Leave blank until each ID has been read back from paddle-live.
VITE_PADDLE_PRICE_LITE_MONTH=
VITE_PADDLE_PRICE_LITE_YEAR=
VITE_PADDLE_PRICE_STANDARD_MONTH=
VITE_PADDLE_PRICE_STANDARD_YEAR=
VITE_PADDLE_PRICE_ADVANCED_MONTH=
VITE_PADDLE_PRICE_ADVANCED_YEAR=
VITE_PADDLE_PRICE_ULTIMATE_MONTH=
VITE_PADDLE_PRICE_ULTIMATE_YEAR=
# Paddle 服务端 API Key（沙箱以 pdl_sdbx_ 开头）：仅服务端使用（webhook 验证、对账），
# 绝不进入任何 client 代码，也不要加 VITE_ 前缀。
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
