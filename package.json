{
  "name": "nexa-cloud",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "author": {
    "name": "PCL.N contributors",
    "url": "https://github.com/MuXue1230-owo/PCL-N-Plugin-Center-Web"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test scripts/*.test.mjs",
    "test:releases": "node --test scripts/nexa-releases.test.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:prod": "pnpm build",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "check": "pnpm type:check && pnpm test && pnpm build",
    "preview": "vite preview",
    "worker:check": "wrangler deploy --dry-run",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.5",
    "element-plus": "^2.14.1",
    "marked": "^18.0.14",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue-i18n": "^11.4.4",
    "vue-tsc": "^3.3.3",
    "wrangler": "4.139.0"
  },
  "browserslist": [
    "Chrome >= 87",
    "Edge >= 88",
    "Safari >= 14",
    "Firefox >= 78"
  ],
  "engines": {
    "node": ">=24.14.0"
  }
}
