{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexa-web",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "pcln.top/*", "zone_name": "pcln.top" }],
  "assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/auth/*", "/geo.json", "/webhooks/wp_wh/*"] },
  "services": [{ "binding": "API", "service": "nexa-api" }, { "binding": "AUTH", "service": "nexa-auth" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
